{
  "datasets": [
    {
      "name": "335fc71b",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SHOW TABLES IN workspace.gold;\n",
        "\n",
        "DESCRIBE TABLE workspace.gold.trai_lsa_switching_usage_context;\n",
        "\n",
        "SELECT *\n",
        "FROM workspace.gold.trai_lsa_switching_usage_context\n",
        "LIMIT 10;\n",
        "\n",
        "SELECT\n",
        "    canonical_lsa,\n",
        "    zone,\n",
        "    may_2026_porting_requests_millions,\n",
        "    june_2026_porting_requests_millions,\n",
        "    ROUND(\n",
        "        june_2026_porting_requests_millions -\n",
        "        may_2026_porting_requests_millions, 3\n",
        "    ) AS change_in_porting_requests,\n",
        "    ROUND(\n",
        "        (\n",
        "            (june_2026_porting_requests_millions -\n",
        "             may_2026_porting_requests_millions)\n",
        "            / NULLIF(may_2026_porting_requests_millions, 0)\n",
        "        ) * 100, 2\n",
        "    ) AS percentage_change\n",
        "FROM workspace.gold.trai_lsa_switching_usage_context\n",
        "ORDER BY june_2026_porting_requests_millions DESC;\n",
        "\n",
        "\n",
        "SELECT\n",
        "    COUNT(DISTINCT canonical_lsa) AS total_lsa,\n",
        "    COUNT(DISTINCT zone) AS total_zones,\n",
        "    SUM(may_2026_porting_requests_millions)\n",
        "        AS may_porting_requests,\n",
        "    SUM(june_2026_porting_requests_millions)\n",
        "        AS june_porting_requests,\n",
        "    ROUND(AVG(prepaid_percentage), 2)\n",
        "        AS avg_prepaid_percentage,\n",
        "    ROUND(AVG(arpu_inr_per_month), 2)\n",
        "        AS avg_arpu\n",
        "FROM workspace.gold.trai_lsa_switching_usage_context;"
      ]
    },
    {
      "name": "8e84de63",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
