        "measures": [
          {
            "name": "TRAI May MNP M",
            "expression": "SUM('trai_lsa_switching_usage_context'[may_2026_porting_requests_millions])",
            "formatString": "#,0.00",
            "lineageTag": "b27738ac-1ecd-42eb-b9b5-b82bcdccb457"
          },
          {
            "name": "TRAI June MNP M",
            "expression": "SUM('trai_lsa_switching_usage_context'[june_2026_porting_requests_millions])",
            "formatString": "#,0.00",
            "lineageTag": "cea8f348-283e-44b2-a8f3-b5af6059459b"
          },
          {
            "name": "TRAI MNP Growth M",
            "expression": "[TRAI June MNP M] - [TRAI May MNP M]",
            "formatString": "#,0.00",
            "lineageTag": "54f55326-462a-415a-9272-b86910f710e9"
          },
          {
            "name": "TRAI MNP Growth Pct",
            "expression": "DIVIDE([TRAI MNP Growth M], [TRAI May MNP M])",
            "formatString": "0.00%",
            "lineageTag": "3a2f3e94-8e5b-46ec-8e89-e4afedbd49b3"
          },
          {
            "name": "TRAI Unweighted ARPU INR",
            "expression": "AVERAGE('trai_lsa_switching_usage_context'[arpu_inr_per_month])",
            "formatString": "\"₹\"#,0.00",
            "lineageTag": "c7e3b8df-1eac-4489-97b6-1318f4633566"
          },
          {
            "name": "TRAI Unweighted Prepaid Share",
            "expression": "DIVIDE(AVERAGE('trai_lsa_switching_usage_context'[prepaid_percentage]), 100)",
            "formatString": "0.00%",
            "lineageTag": "a58bcb0d-db7e-4891-af8c-35e056790c58"
          },
          {
            "name": "TRAI Unweighted Total MOU",
            "expression": "AVERAGE('trai_lsa_switching_usage_context'[total_mou_per_month])",
            "formatString": "#,0.00",
            "lineageTag": "f275fd66-c1d6-419f-a1f0-9ceb6c30aad0"
          },
          {
            "name": "TRAI Active Circles",
            "expression": "DISTINCTCOUNT('trai_lsa_switching_usage_context'[canonical_lsa])",
            "formatString": "#,0",
            "lineageTag": "a5be0723-620f-43d8-afe6-75960f82531d"
          },
          {
            "name": "TRAI Outgoing MOU",
            "expression": "AVERAGE('trai_lsa_switching_usage_context'[outgoing_mou_per_month])",
            "formatString": "#,0.00",
            "lineageTag": "8be19787-2e7d-451e-948c-044f507f6686"
          },
          {
            "name": "TRAI Incoming MOU",
