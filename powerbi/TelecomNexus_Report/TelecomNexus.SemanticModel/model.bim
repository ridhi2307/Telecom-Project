        "measures": [
          {
            "name": "IBM Customers",
            "expression": "DISTINCTCOUNT('ibm_telco_customer_churn'[CustomerID])",
            "formatString": "#,0",
            "lineageTag": "1578c47d-56a1-4b34-b5bf-c3f4626ff23d"
          },
          {
            "name": "IBM Churned Customers",
            "expression": "CALCULATE(DISTINCTCOUNT('ibm_telco_customer_churn'[CustomerID]), 'ibm_telco_customer_churn'[Churn_Value] = 1)",
            "formatString": "#,0",
            "lineageTag": "61a583fa-d30d-4e89-9a58-458c21fc18e5"
          },
          {
            "name": "IBM Retained Customers",
            "expression": "CALCULATE(DISTINCTCOUNT('ibm_telco_customer_churn'[CustomerID]), 'ibm_telco_customer_churn'[Churn_Value] = 0)",
            "formatString": "#,0",
            "lineageTag": "cadae94a-1b5b-4c49-bad7-7b056fa2ddba"
          },
          {
            "name": "IBM Churn Rate",
            "expression": "DIVIDE([IBM Churned Customers], [IBM Customers])",
            "formatString": "0.00%",
            "lineageTag": "6d1181e8-646a-4a99-bd75-8b331cd483f4"
          },
          {
            "name": "IBM Avg Monthly Charges",
            "expression": "AVERAGE('ibm_telco_customer_churn'[Monthly_Charges])",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "e1dd3c26-cc9c-47aa-9ceb-2c9f19d2bd53"
          },
          {
            "name": "IBM Churned Monthly Charges",
            "expression": "CALCULATE(SUM('ibm_telco_customer_churn'[Monthly_Charges]), 'ibm_telco_customer_churn'[Churn_Value] = 1)",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "c67299e4-1725-4dfb-bc1e-29380ca41fa3"
          },
          {
            "name": "IBM Avg Tenure",
            "expression": "AVERAGE('ibm_telco_customer_churn'[Tenure_Months])",
            "formatString": "#,0.00",
            "lineageTag": "9846cded-7e3d-46db-90b0-72f216d5059c"
          }
        ],
        "partitions": [
          {
