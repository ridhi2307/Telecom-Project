            "formatString": "0.00%",
            "lineageTag": "8c662bfa-f83c-405d-b3ff-c91e05879dde"
          },
          {
            "name": "Latency cell color",
            "expression": "VAR ms = [QoS Avg Latency ms] RETURN IF(ISBLANK(ms), BLANK(), IF(ms >= MEDIANX(ALLSELECTED(trai_qos), trai_qos[metric_12]), \"#F6E2BD\", \"#C6E5DF\"))",
            "isHidden": true,
            "lineageTag": "72ec5d10-01da-4ce5-85ca-dc0daf7cc9c2"
          }
