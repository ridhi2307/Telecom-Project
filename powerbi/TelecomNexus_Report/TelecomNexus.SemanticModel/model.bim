            "formatString": "#,0.00",
            "lineageTag": "b0527cbb-9ff4-48cf-abb8-e197b3dce3b3"
          }
        ],
        "partitions": [
          {
            "name": "trai_lsa_switching_usage_context",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\trai_lsa_switching_usage_context.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Clean = Table.TransformColumns(Headers, List.Transform({\"may_2026_porting_requests_millions\", \"june_2026_porting_requests_millions\", \"prepaid_percentage\", \"arpu_inr_per_month\", \"outgoing_sms_per_month\", \"outgoing_mou_per_month\", \"incoming_mou_per_month\", \"total_mou_per_month\"}, (col) => {col, each if _ = null or Text.Trim(_) = \"\" then null else _})),",
                "    Typed = Table.TransformColumnTypes(Clean, {{\"canonical_lsa\", type text}, {\"zone\", type text}, {\"mnp_report_month\", type text}, {\"may_2026_porting_requests_millions\", type number}, {\"june_2026_porting_requests_millions\", type number}, {\"category\", type text}, {\"prepaid_percentage\", type number}, {\"arpu_inr_per_month\", type number}, {\"outgoing_sms_per_month\", type number}, {\"outgoing_mou_per_month\", type number}, {\"incoming_mou_per_month\", type number}, {\"total_mou_per_month\", type number}, {\"usage_reporting_period\", type text}}, \"en-US\")",
                "in",
