            "name": "QoS Avg Latency ms",
            "expression": "AVERAGE('trai_qos'[metric_12])",
            "formatString": "#,0.00",
            "lineageTag": "bb28ec95-5cad-4310-b294-4cfc8d397fc5"
          },
          {
            "name": "QoS Intra Call Setup Rate",
            "expression": "DIVIDE(AVERAGE('trai_qos'[metric_05]), 100)",
            "formatString": "0.00%",
            "lineageTag": "4c36ab30-5a4e-40cd-a8ad-ca600d2c9f4b"
          },
          {
            "name": "QoS Inter Call Setup Rate",
            "expression": "DIVIDE(AVERAGE('trai_qos'[metric_06]), 100)",
            "formatString": "0.00%",
