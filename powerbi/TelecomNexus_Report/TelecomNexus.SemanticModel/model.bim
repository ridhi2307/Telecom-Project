                "    Typed = Table.TransformColumnTypes(Clean, {{\"CustomerID\", type text}, {\"Count\", Int64.Type}, {\"Country\", type text}, {\"State\", type text}, {\"City\", type text}, {\"Zip_Code\", type text}, {\"Lat_Long\", type text}, {\"Latitude\", type number}, {\"Longitude\", type number}, {\"Gender\", type text}, {\"Senior_Citizen\", type text}, {\"Partner\", type text}, {\"Dependents\", type text}, {\"Tenure_Months\", Int64.Type}, {\"Phone_Service\", type text}, {\"Multiple_Lines\", type text}, {\"Internet_Service\", type text}, {\"Online_Security\", type text}, {\"Online_Backup\", type text}, {\"Device_Protection\", type text}, {\"Tech_Support\", type text}, {\"Streaming_TV\", type text}, {\"Streaming_Movies\", type text}, {\"Contract\", type text}, {\"Paperless_Billing\", type text}, {\"Payment_Method\", type text}, {\"Monthly_Charges\", Currency.Type}, {\"Total_Charges\", Currency.Type}, {\"Churn_Label\", type text}, {\"Churn_Value\", Int64.Type}, {\"Churn_Score\", Int64.Type}, {\"CLTV\", Int64.Type}, {\"Churn_Reason\", type text}}, \"en-US\")",
                "in",
